{
  // Come si lavora al registro da dentro l'editor.
  //
  // Prima qui c'erano due task che partivano da soli all'apertura della
  // cartella: uno metteva una giunzione in `~/.vscode/extensions`, l'altro
  // teneva `dist/` allineato. Servivano perché il registro *era* un'estensione
  // e girava dentro questa finestra. Adesso è un'applicazione a sé: si lancia,
  // e mentre gira si modifica il codice — a ricaricare le pagine e a riavviarla
  // pensa lei.
  //
  // Niente più `runOn: folderOpen`, per la stessa ragione: aprire la cartella
  // del progetto non deve far partire l'applicazione del docente.
  "version": "2.0.0",
  "tasks": [
    {
      // Il comando con cui si lavora. Resta in piedi finché non lo si ferma.
      "label": "registro: sviluppo",
      "type": "shell",
      "command": "npm run sviluppo",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "registro" },
      "problemMatcher": []
    },
    {
      "label": "registro: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "presentation": { "reveal": "silent", "close": true, "panel": "dedicated", "group": "registro" },
      // esbuild non parla come tsc: i suoi errori si riconoscono dalla riga
      // "✘ [ERROR] …" seguita da "file:riga:colonna:".
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}/extension"],
        "pattern": [
          {
            "regexp": "^[✘▲] \\[(ERROR|WARNING)\\] (.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+(\\S.*?):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    },
    {
      "label": "registro: controllo tipi",
      "type": "shell",
      "command": "npm run controllo-tipi",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "registro" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "registro: prove",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "registro" },
      "problemMatcher": []
    }
  ]
}
