{
  "name": "regiklass",
  "productName": "Regiklass",
  "desktopName": "ch.nabre.regiklass.desktop",
  "description": "Registro di classe per docenti: calendario delle lezioni, classi e persone in formazione, piani lezione e momenti di valutazione.",
  "version": "1.6.0",
  "license": "MIT",
  "author": "Michel Brenna",
  "homepage": "https://github.com/nabre/Registro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabre/Registro.git"
  },
  "bugs": {
    "url": "https://github.com/nabre/Registro/issues"
  },
  "private": true,
  "keywords": [
    "registro",
    "scuola",
    "docenti",
    "lezioni",
    "valutazioni"
  ],
  "main": "dist/main.cjs",
  "imports": {
    "#core/*": "./core/*",
    "#contract/*": "./contract/*",
    "#desktop/*": "./desktop/*",
    "#ui/*": "./ui/*"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node esbuild.mjs",
    "start": "npm run build && electron .",
    "regi": "node cli/main.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.js.json",
    "lint": "eslint .",
    "clean": "node tools/clean.mjs",
    "census": "node tools/census.mjs",
    "collections": "node tools/collections.mjs",
    "buttons": "node tools/buttons.mjs",
    "forms": "node tools/forms.mjs",
    "layers": "node tools/layers.mjs",
    "knip": "knip --no-progress",
    "licenze": "node tools/licenses.mjs",
    "docs": "node tools/docs.mjs",
    "i18n": "node tools/i18n.mjs",
    "pretest": "node esbuild.mjs --test",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:spec": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:watch": "node --watch --test \"tests/**/*.test.mjs\"",
    "test:domain": "node --test \"tests/domain/**/*.test.mjs\"",
    "test:api": "node --test \"tests/api/**/*.test.mjs\"",
    "test:data": "node --test \"tests/data/**/*.test.mjs\"",
    "test:env": "node --test \"tests/environment/**/*.test.mjs\"",
    "test:ui": "node --test \"tests/ui/**/*.test.mjs\"",
    "test:cli": "node --test \"tests/cli/**/*.test.mjs\"",
    "copertura": "node tools/coverage.mjs",
    "mutanti": "node tools/mutants.mjs",
    "misura:immer": "node tools/immerBench.mjs",
    "fumo": "node tools/smoke.mjs",
    "ui-tests": "node tools/uiTests.mjs",
    "ci": "node tools/ci.mjs",
    "package": "node tools/schoolCalendar.mjs && node esbuild.mjs --produzione && node tools/pack.mjs --config electron-builder.json",
    "icons": "electron tools/icons.cjs",
    "templates": "node tools/templates.mjs",
    "calendario": "node tools/schoolCalendar.mjs",
    "procedures": "node tools/procedures.mjs",
    "tools": "node esbuild.mjs --test && node tools/assistantTools.mjs",
    "modelli-consigliati": "node tools/recommendedModels.mjs",
    "sample": "node esbuild.mjs --test && node tools/sample.mjs"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "chokidar": "^5.0.0",
    "dependency-cruiser": "^18.4.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "pdfjs-dist": "^6.3.289",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@tanstack/virtual-core": "^3.17.11",
    "electron-updater": "^6.8.9",
    "immer": "^11.1.18",
    "node-llama-cpp": "^3.21.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "valibot": "^1.5.0"
  }
}
