{
  "name": "registro-docenti",
  "productName": "Registro docenti",
  "description": "Registro di classe per docenti: calendario delle lezioni, classi e persone in formazione, piani lezione e momenti di valutazione.",
  "version": "1.0.0",
  "license": "MIT",
  "author": "CPTT",
  "private": true,
  "keywords": [
    "registro",
    "scuola",
    "docenti",
    "lezioni",
    "valutazioni"
  ],
  "main": "dist/principale.cjs",
  "scripts": {
    "sviluppo": "node strumenti/sviluppo.mjs",
    "build": "node esbuild.mjs",
    "avvia": "npm run build && electron .",
    "controllo-tipi": "tsc --noEmit",
    "pretest": "node esbuild.mjs --test",
    "test": "node --test \"prove/**/*.test.mjs\"",
    "pacchetto": "node esbuild.mjs --produzione && electron-builder --config electron-builder.json",
    "icone": "electron strumenti/icone.cjs",
    "modelli": "node strumenti/modelli.mjs",
    "campione": "node esbuild.mjs --test && node strumenti/campione.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  }
}
